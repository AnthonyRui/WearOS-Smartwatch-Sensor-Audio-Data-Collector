<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"> <!-- Updated theme to use AppCompat -->

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/AppTheme"> <!-- Updated theme for the activity -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".presentation.SensorCollectionService"
            android:exported="false"
            android:foregroundServiceType="microphone|health" />

        <service
            android:name=".presentation.PhoneSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />
    </application>

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- Required to keep reading body sensors (heart rate, etc.) while the service runs in the background -->
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <!-- Required on API 31+ to register sensors faster than the OS default cap (needed for SENSOR_DELAY_FASTEST) -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Required for Step Counter / Step Detector sensors on API 29+ -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Required to run the sensor/audio collection service in the foreground -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Required for the phone-sync foreground service on API 34+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Required to show the ongoing-collection notification on API 33+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required to connect to the paired phone over RFCOMM to send collected data -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />



</manifest>
